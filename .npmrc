# esbuild and protobufjs place platform binaries in postinstall scripts. pnpm 11
# declines to run those without explicit approval, and an unapproved esbuild
# fails `pnpm build` at the bundling step — on a clean CI checkout as well as
# locally.
#
# This list lives here rather than in package.json (`pnpm.onlyBuiltDependencies`
# is no longer read) or pnpm-workspace.yaml (not honoured by 11.21).
only-built-dependencies[]=esbuild
only-built-dependencies[]=@google/genai
only-built-dependencies[]=protobufjs
