# GEMINI_API_KEY: Required for the Socratic AI coach. Without it the coach falls
# back to its deterministic engine rather than failing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Where this instance is hosted. Used for self-referential links.
APP_URL="MY_APP_URL"

# DATABASE_URL: MySQL-compatible connection string. Required — there is no
# local-file fallback by design, because a silent one presents an empty
# database as a working install.
#
# For local development:
#   docker run -d --name acuitymath-mysql -e MYSQL_ROOT_PASSWORD=root \
#     -e MYSQL_DATABASE=acuitymath -p 3307:3306 mysql:8.4
#   DATABASE_URL=mysql://root:root@127.0.0.1:3307/acuitymath pnpm db:migrate
DATABASE_URL="mysql://root:root@127.0.0.1:3307/acuitymath"

# JWT_SECRET: Signs the session cookie. Required — sessions cannot be issued or
# verified without it, and a generated one would mean every restart signs
# everybody out. Generate with `openssl rand -base64 48`.
JWT_SECRET=""

# APP_BASE_URL: Where sign-in links point. Required in production; in
# development the request's own origin is used.
APP_BASE_URL="http://localhost:3000"

# SMTP: how sign-in links are delivered. Without these, in development, links
# are written to the server log instead of emailed — and said so, loudly.
# Required in production: a deployment that cannot send the only credential it
# issues is broken.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AcuityMath <no-reply@example.com>"

# DEV_AUTH_EMAIL: authenticates every request as this address, bypassing
# sign-in entirely. Development only — the server throws if it is set in a
# production build.
DEV_AUTH_EMAIL=""
